{
  "description": "Template for GatherBatchEvidence workflow",
  "static_params": [
    "primary_contigs_fai",
    "genome_file",
    "sd_locs_vcf",
    "mei_bed",
    "cytoband",
    "cytoband_idx",
    "ref_dict",
    "cnmops_chrom_file",
    "cnmops_allo_file",
    "cnmops_exclude_list",
    "allosomal_contigs"
  ],
  "docker_params": [
    "sv_pipeline_docker",
    "sv_base_mini_docker",
    "sv_base_docker",
    "sv_pipeline_qc_docker",
    "cnmops_docker",
    "linux_docker",
    "gatk_docker",
    "gcnv_gatk_docker",
    "condense_counts_docker",
    "manifest_reader_docker"
  ],
  "dynamic_params": {
    "batch": "{{batch_id}}",
    "ped_file": "{{ped_file}}",
    "samples": "{{query:ddb:samples_in_batch}}",
    "counts": "{{query:ddb:output_paths:GatherSampleEvidence:coverage_counts:tsv.gz}}",
    "PE_files": "{{query:ddb:output_paths:GatherSampleEvidence:pesr_disc:txt.gz}}",
    "PE_file_indexes": "{{query:ddb:output_paths:GatherSampleEvidence:pesr_disc_index:txt.gz.tbi}}",
    "SR_files": "{{query:ddb:output_paths:GatherSampleEvidence:pesr_split:txt.gz}}",
    "SD_files": "{{query:ddb:output_paths:GatherSampleEvidence:pesr_sd:txt.gz}}",
    "manta_vcfs": "{{query:ddb:output_paths:GatherSampleEvidence:manta_vcf:vcf.gz}}",
    "scramble_vcfs": "{{query:ddb:output_paths:GatherSampleEvidence:scramble_vcf:vcf.gz}}",
    "wham_vcfs": "{{query:ddb:output_paths:GatherSampleEvidence:wham_vcf:vcf.gz}}",
    "contig_ploidy_model_tar": "{{query:ddb:output_paths:TrainGCNV:cohort_contig_ploidy_model_tar:tar.gz:glob:single}}",
    "gcnv_model_tars": "{{query:ddb:output_paths:TrainGCNV:cohort_gcnv_model_tars:tar.gz:glob}}"
  },
  "optional_params": {
    "run_matrix_qc": true,
    "min_svsize": 50,
    "matrix_qc_distance": 1000000,
    "ploidy_sample_psi_scale": 0.001,
    "ref_copy_number_autosomal_contigs": 2,
    "gcnv_learning_rate": 0.03,
    "gcnv_num_thermal_advi_iters": 250,
    "gcnv_max_advi_iter_first_epoch": 1000,
    "gcnv_max_advi_iter_subsequent_epochs": 200,
    "gcnv_max_training_epochs": 5,
    "gcnv_min_training_epochs": 1,
    "gcnv_convergence_snr_averaging_window": 100,
    "gcnv_convergence_snr_countdown_window": 10,
    "gcnv_cnv_coherence_length": 1000,
    "gcnv_copy_number_posterior_expectation_mode": "EXACT",
    "gcnv_log_emission_sampling_rounds": 20,
    "gcnv_p_alt": 1e-06,
    "gcnv_sample_psi_scale": 1e-06,
    "gcnv_caller_internal_admixing_rate": 0.5,
    "gcnv_caller_update_convergence_threshold": 1e-06,
    "gcnv_convergence_snr_trigger_threshold": 0.2,
    "gcnv_depth_correction_tau": 10000.0,
    "gcnv_log_emission_sampling_median_rel_error": 0.001,
    "gcnv_qs_cutoff": 30
  }
}