{
  "description": "Template for AnnotateVcf workflow",
  "static_params": [
    "contig_list",
    "protein_coding_gtf",
    "noncoding_bed",
    "external_af_ref_bed",
    "external_af_ref_prefix",
    "external_af_population",
    "par_bed"
  ],
  "docker_params": [
    "sv_pipeline_docker",
    "sv_base_mini_docker",
    "gatk_docker"
  ],
  "dynamic_params": {
    "prefix": "{{cohort_id}}",
    "ped_file": "{{ped_file}}",
    "vcf": "{{query:ddb:output_paths:FilterGenotypes:filtered_vcf:vcf.gz:glob:single}}",
    "vcf_index": "{{query:ddb:output_paths:FilterGenotypes:filtered_vcf_index:tbi:glob:single}}"
  },
  "optional_params": {
    "sv_per_shard": 5000
  }
}
