{
  "description": "Template for FilterBatch workflow",
  "static_params": [
    "primary_contigs_list"
  ],
  "docker_params": [
    "sv_pipeline_docker",
    "sv_base_mini_docker",
    "linux_docker"
  ],
  "dynamic_params": {
    "batch": "{{batch_id}}",
    "ped_file": "{{ped_file}}",
    "evidence_metrics": "{{query:ddb:output_paths:GenerateBatchMetrics:metrics:metrics:glob:single}}",
	"evidence_metrics_common": "{{query:ddb:output_paths:GenerateBatchMetrics:metrics_common:metrics:glob:single}}",
    "depth_vcf": "{{query:ddb:output_paths:ClusterBatch:clustered_depth_vcf:vcf.gz:glob:single}}",
    "depth_vcf_index": "{{query:ddb:output_paths:ClusterBatch:clustered_depth_vcf_index:tbi:glob:single}}",
    "dragen_vcf": "{{query:ddb:output_paths:ClusterBatch:clustered_dragen_vcf:vcf.gz:glob:single}}",
    "dragen_vcf_index": "{{query:ddb:output_paths:ClusterBatch:clustered_dragen_vcf_index:tbi:glob:single}}",
    "manta_vcf": "{{query:ddb:output_paths:ClusterBatch:clustered_manta_vcf:vcf.gz:glob:single}}",
    "manta_vcf_index": "{{query:ddb:output_paths:ClusterBatch:clustered_manta_vcf_index:tbi:glob:single}}",
    "melt_vcf": "{{query:ddb:output_paths:ClusterBatch:clustered_melt_vcf:vcf.gz:glob:single}}",
    "melt_vcf_index": "{{query:ddb:output_paths:ClusterBatch:clustered_melt_vcf_index:tbi:glob:single}}",
    "wham_vcf": "{{query:ddb:output_paths:ClusterBatch:clustered_wham_vcf:vcf.gz:glob:single}}",
    "wham_vcf_index": "{{query:ddb:output_paths:ClusterBatch:clustered_wham_vcf_index:tbi:glob:single}}",
    "scramble_vcf": "{{query:ddb:output_paths:ClusterBatch:clustered_scramble_vcf:vcf.gz:glob:single}}",
    "scramble_vcf_index": "{{query:ddb:output_paths:ClusterBatch:clustered_scramble_vcf_index:tbi:glob:single}}"
  },
  "optional_params": {
    "outlier_cutoff_nIQR": 6
  },
  "optional_file_params": [
    "adjudicate_cutoffs",
    "adjudicate_scores",
    "adjudicate_rf_files"
  ]
}
