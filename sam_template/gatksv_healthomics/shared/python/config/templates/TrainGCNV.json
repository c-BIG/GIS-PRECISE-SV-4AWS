{
  "description": "Template for TrainGCNV workflow",
  "static_params": [
    "reference_fasta",
    "reference_index",
    "reference_dict",
    "contig_ploidy_priors",
    "exclude_intervals_for_filter_intervals_cnv",
    "exclude_intervals_for_filter_intervals_ploidy",
    "allosomal_contigs"
  ],
  "docker_params": [
    "sv_base_mini_docker",
    "gatk_docker",
    "linux_docker",
    "sv_pipeline_docker",
	"condense_counts_docker"
  ],
  "dynamic_params": {
    "cohort": "{{batch_id}}",
    "samples": "{{query:ddb:samples_in_batch}}",
    "count_files": "{{query:ddb:output_paths:GatherSampleEvidence:coverage_counts:tsv.gz}}"
  },
  "optional_params": {
    "ref_copy_number_autosomal_contigs": 2,
    "num_intervals_per_scatter": 5000,
    "do_explicit_gc_correction": true,
    "gcnv_enable_bias_factors": false,
    "gcnv_caller_update_convergence_threshold": 0.000001,
    "gcnv_class_coherence_length": 1000.0,
    "gcnv_convergence_snr_trigger_threshold": 0.2,
    "gcnv_interval_psi_scale": 0.000001,
    "gcnv_log_mean_bias_standard_deviation": 0.01,
    "gcnv_max_bias_factors": 1,
    "gcnv_max_calling_iters": 20,
    "ploidy_global_psi_scale": 0.05,
    "ploidy_mean_bias_standard_deviation": 1.0,
    "gcnv_depth_correction_tau": 10000.0,
    "gcnv_log_emission_sampling_median_rel_error": 0.001,
    "gcnv_model_learning_rate": 0.03,
    "gcnv_model_num_thermal_advi_iters": 2500,
    "gcnv_model_max_advi_iter_first_epoch": 5000,
    "gcnv_model_max_advi_iter_subsequent_epochs": 200,
    "gcnv_model_max_training_epochs": 50,
    "gcnv_model_min_training_epochs": 5,
    "gcnv_model_convergence_snr_averaging_window": 500,
    "gcnv_model_convergence_snr_countdown_window": 10,
    "gcnv_model_cnv_coherence_length": 1000,
    "gcnv_learning_rate": 0.03,
    "gcnv_num_thermal_advi_iters": 250,
    "gcnv_max_advi_iter_first_epoch": 5000,
    "gcnv_max_advi_iter_subsequent_epochs": 200,
    "gcnv_max_training_epochs": 50,
    "gcnv_min_training_epochs": 5,
    "gcnv_convergence_snr_averaging_window": 100,
    "gcnv_convergence_snr_countdown_window": 10,
    "gcnv_cnv_coherence_length": 1000,
    "gcnv_copy_number_posterior_expectation_mode": "EXACT",
    "gcnv_log_emission_sampling_rounds": 20,
    "gcnv_p_alt": 0.000001,
    "gcnv_sample_psi_scale": 0.000001,
    "ploidy_sample_psi_scale": 0.001,
    "n_samples_subsample": 100
  }
}