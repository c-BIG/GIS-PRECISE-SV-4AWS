{
  "description": "Template for EvidenceQC workflow DEFAULT assume manta_vcfs",
  "static_params": [
    "wgd_scoring_mask",
    "genome_file"
  ],
  "docker_params": [
    "sv_pipeline_docker",
    "sv_base_mini_docker",
    "sv_pipeline_qc_docker",
    "sv_base_docker",
    "manifest_reader_docker"
  ],
  "dynamic_params": {
    "batch": "{{batch_id}}",
    "samples": "{{query:ddb:samples_in_batch}}",
    "counts": "{{query:ddb:output_paths:GatherSampleEvidence:coverage_counts:tsv.gz}}",
    "manta_vcfs": "{{query:ddb:output_paths:GatherSampleEvidence:manta_vcf:vcf.gz}}",
	"dragen_vcfs": "{{query:ddb:output_paths:GatherSampleEvidence:dragen_proc_vcf:vcf.gz}}",
    "wham_vcfs": "{{query:ddb:output_paths:GatherSampleEvidence:wham_vcf:vcf.gz}}",
    "scramble_vcfs": "{{query:ddb:output_paths:GatherSampleEvidence:scramble_vcf:vcf.gz}}",
	"melt_vcfs": "{{query:ddb:output_paths:GatherSampleEvidence:melt_vcf:vcf.gz}}"
  },
  "optional_params": {
    "run_vcf_qc": "true"
  }
}
